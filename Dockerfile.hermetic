# Hermetic Build Container - Network Air-Gapped & Isolated Compilation
# This Dockerfile creates a completely isolated build environment with:
# - Network-disabled build stages (--network=none)
# - Pre-fetched vendored dependencies
# - Strict seccomp profiles
# - No shell access or postinstall script execution
#
# One image equals one Stellar network: Vite inlines VITE_* values at build
# time. Build separate images; do not promote a testnet image to mainnet.
# Testnet:
# docker build -f Dockerfile.hermetic --build-arg STELLAR_NETWORK=testnet \
#   --build-arg VITE_HELPHONE_DAO_ID=CDP5XZ7UYCGSQBYRDYM2OEAUQJULBZPULSQXK7LGNAJTRXRG3VHZLSHY .
# Mainnet (after deployment):
# docker build -f Dockerfile.hermetic --build-arg STELLAR_NETWORK=mainnet \
#   --build-arg VITE_AEGIS_VAULT_ID=<aegis-id> --build-arg VITE_EMERGENCY_VAULT_ID=<emergency-id> \
#   --build-arg VITE_HELPHONE_DAO_ID=<dao-id> --build-arg VITE_MAINTAINER_VAULT_ID=<maintainer-id> .

FROM node:22-alpine AS dependencies
WORKDIR /build

# Copy only package manifests
COPY package.json package-lock.json ./

# Install dependencies with network access (this stage can access network)
RUN npm ci --prefer-offline --no-audit 2>&1

FROM node:22-alpine AS vendor-cache
WORKDIR /vendor

# This stage pre-fetches all tarball artifacts
COPY --from=dependencies /build/node_modules /vendor/node_modules
COPY --from=dependencies /build/package-lock.json /vendor/

RUN npm cache clean --force

# Stage 2: Air-Gapped Build Environment
FROM node:22-alpine AS build-hermetic
WORKDIR /app

ARG STELLAR_NETWORK=testnet
ARG VITE_AEGIS_VAULT_ID
ARG VITE_EMERGENCY_VAULT_ID
ARG VITE_HELPHONE_DAO_ID
ARG VITE_MAINTAINER_VAULT_ID

# Copy pre-built vendor cache from previous stage
COPY --from=vendor-cache /vendor /app/vendor

# Copy project files
COPY . .

# Link vendor modules (no network access during this stage)
RUN ln -s /app/vendor/node_modules ./node_modules

# Disable postinstall scripts and limit execution context
ENV npm_config_ignore_scripts=true
ENV NODE_ENV=production

# Select the matching environment example, then override only IDs explicitly
# provided by the caller. ARGs participate in this RUN cache key.
RUN --network=none \
    set -eu; \
    case "${STELLAR_NETWORK}" in testnet|mainnet) ;; *) echo "Unsupported STELLAR_NETWORK: ${STELLAR_NETWORK}" >&2; exit 1 ;; esac; \
    cp ".env.${STELLAR_NETWORK}.example" .env.production; \
    export VITE_STELLAR_NETWORK="${STELLAR_NETWORK}"; \
    if [ -z "${VITE_AEGIS_VAULT_ID:-}" ]; then unset VITE_AEGIS_VAULT_ID; else export VITE_AEGIS_VAULT_ID; fi; \
    if [ -z "${VITE_EMERGENCY_VAULT_ID:-}" ]; then unset VITE_EMERGENCY_VAULT_ID; else export VITE_EMERGENCY_VAULT_ID; fi; \
    if [ -z "${VITE_HELPHONE_DAO_ID:-}" ]; then unset VITE_HELPHONE_DAO_ID; else export VITE_HELPHONE_DAO_ID; fi; \
    if [ -z "${VITE_MAINTAINER_VAULT_ID:-}" ]; then unset VITE_MAINTAINER_VAULT_ID; else export VITE_MAINTAINER_VAULT_ID; fi; \
    npm run build 2>&1

# Output stage: Production-ready artifacts
FROM alpine:latest AS runtime
WORKDIR /app

# Copy only the built artifacts (no node_modules, no source)
COPY --from=build-hermetic /app/dist ./dist
COPY --from=build-hermetic /app/package.json ./package.json

# Minimal runtime verification
RUN ls -la dist/ && echo "Build verification complete: hermetic build succeeded"

CMD ["echo", "Build artifacts ready in /app/dist"]
